---
layout: layouts/page.njk
title: Blog / Tags
permalink: /tags/index.html
---

<div class="post-header-section">
  <div class="post-header-content">
    <div class="post-header-topline">
      <h1>Tags</h1>
      <nav class="crumb" aria-label="Breadcrumb">
        <a class="crumb-link" href="/post/">
          <svg class="crumb-icon" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M2.5 1A1.5 1.5 0 0 0 1 2.5v11A1.5 1.5 0 0 0 2.5 15h11a1.5 1.5 0 0 0 1.5-1.5v-11A1.5 1.5 0 0 0 13.5 1h-11ZM3 2.5a.5.5 0 0 1 .5-.5H6v3H3V2.5ZM7 2h3.5a.5.5 0 0 1 .5.5V5H7V2Zm-4 5V6h3v1H3Zm4 0V6h4.5a.5.5 0 0 1 .5.5V7H7Zm0 1h5v5.5a.5.5 0 0 1-.5.5H7V8Zm-1 6V8H3v6h3Z"/></svg>
          <span>Blog</span>
        </a>
      </nav>
    </div>
  </div>
</div>

<div class="post-content-section">
  <div class="post-content-wrapper">
    <div class="post-browse-card">
      <p>
        You can also read posts in <a href="/post">chronological order</a> or grouped by <a href="/series/">series</a>.
      </p>
    </div>

    {% if collections.tagsList and collections.tagsList.length %}
    <ul class="tag-grid">
      {% for tag in collections.tagsList %}
      <li class="tag-card interactive-card">
        <a href="/tags/{{ tag.slug }}/">
          <span class="tag-name">{{ tag.name }}</span>
          <span class="tag-count">{{ tag.posts | length }} posts</span>
        </a>
      </li>
      {% endfor %}
    </ul>
    {% else %}
    <p>No tags have been published yet.</p>
    {% endif %}
  </div>
</div>
