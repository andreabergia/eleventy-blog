---
layout: layouts/page.njk
pagination:
  data: collections.tagsList
  size: 1
  alias: tag
permalink: /tags/{{ tag.slug }}/index.html
eleventyComputed:
  title: "Blog / Tag: {{ tag.name }}"
---

{% from "components/breadcrumb.njk" import breadcrumb %}
{% from "components/post-list.njk" import postList %}

<div class="post-header-section">
  <div class="post-header-content">
    <div class="post-header-topline">
      <h1>#{{ tag.name }}</h1>
      {{ breadcrumb([{ url: "/tags/", label: "Tags" }]) }}
    </div>
    {% if tag.posts and tag.posts.length %}
    <div class="post-metadata">
      <div class="post-meta-row">
        <span class="post-meta-item">
          {{ tag.posts | length }} posts tagged
        </span>
      </div>
    </div>
    {% endif %}
  </div>
</div>

<div class="post-content-section">
  <div class="post-content-wrapper">
    {{ postList(
      tag.posts,
      listClass = "post-list--stacked"
    ) }}
  </div>
</div>
