---
layout: layouts/page.njk
pagination:
  data: collections.tagsList
  size: 1
  alias: tag
permalink: /tags/{{ tag.slug }}/index.html
eleventyComputed:
  title: "Blog / Tag: {{ tag.name }}"
---

<div class="post-header-section">
  <div class="post-header-content">
    <div class="post-header-topline">
      <h1>#{{ tag.name }}</h1>
      <nav class="crumb" aria-label="Breadcrumb">
        <a class="crumb-link" href="/post/">
          <svg class="crumb-icon" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M2.5 1A1.5 1.5 0 0 0 1 2.5v11A1.5 1.5 0 0 0 2.5 15h11a1.5 1.5 0 0 0 1.5-1.5v-11A1.5 1.5 0 0 0 13.5 1h-11ZM3 2.5a.5.5 0 0 1 .5-.5H6v3H3V2.5ZM7 2h3.5a.5.5 0 0 1 .5.5V5H7V2Zm-4 5V6h3v1H3Zm4 0V6h4.5a.5.5 0 0 1 .5.5V7H7Zm0 1h5v5.5a.5.5 0 0 1-.5.5H7V8Zm-1 6V8H3v6h3Z"/></svg>
          <span>Blog</span>
        </a>
        <span class="crumb-separator">›</span>
        <a class="crumb-link" href="/tags/">Tags</a>
      </nav>
    </div>
    {% if tag.posts and tag.posts.length %}
    <div class="post-metadata">
      <div class="post-meta-row">
        <span class="post-meta-item">
          {{ tag.posts | length }} posts tagged
        </span>
      </div>
    </div>
    {% endif %}
  </div>
</div>

<div class="post-content-section">
  <div class="post-content-wrapper">
    {% if tag.posts and tag.posts.length %}
    <ul class="post-list post-list--stacked">
      {% for post in tag.posts %}
      <li>
        <a href="{{ post.url }}">
          <span class="post-meta">{{ post.date | readableDate }}</span>
          <span class="post-title">{{ post.data.title }}</span>
        </a>
      </li>
      {% endfor %}
    </ul>
    {% else %}
    <p>There are no posts for this tag yet.</p>
    {% endif %}
  </div>
</div>
