<!DOCTYPE html>
<html lang="{{ site.language or 'en' }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    {% set pageTitle = title or site.title %}
    {% set pageDescription = description or excerpt or site.description %}
    <title>{{ pageTitle }}</title>
    {% if pageDescription %}
    <meta name="description" content="{{ pageDescription }}">
    {% endif %}
    {% if site.keywords %}
    <meta name="keywords" content="{{ site.keywords | join(', ') }}">
    {% endif %}
    {% if site.author %}
    <meta name="author" content="{{ site.author.name }}">
    {% endif %}
    
    {% set pagePath = page.url | default('/') %}
    {% if pagePath == '/' %}
      {% set canonicalUrl = 'https://andreabergia.com/' %}
      <meta property="og:url" content="{{ canonicalUrl }}">
    {% else %}
      {% set canonicalUrl = pagePath | absoluteUrl %}
      <meta property="og:url" content="{{ canonicalUrl }}">
    {% endif %}
    <link rel="canonical" href="{{ canonicalUrl }}">
    <link rel="icon" type="image/png" href="/images/favicon-16x16.png" sizes="16x16">
    <link rel="icon" type="image/png" href="/images/favicon-32x32.png" sizes="32x32">
    <link rel="apple-touch-icon" href="/images/apple-touch-icon.png">
    
    {% set isPost = page.date is defined %}
    <meta property="og:title" content="{{ pageTitle }}">
    <meta property="og:description" content="{{ pageDescription }}">
    {% if isPost %}
    <meta property="og:type" content="article">
    {% else %}
    <meta property="og:type" content="website">
    {% endif %}
    <meta property="og:site_name" content="{{ site.title }}">
    <meta property="og:locale" content="{{ site.language or 'en' }}">
    
    {% if image %}
      {% set fullPageImage = image | absoluteUrl %}
      <meta property="og:image" content="{{ fullPageImage }}">
      <meta name="twitter:image" content="{{ fullPageImage }}">
    {% endif %}
    
    <meta name="twitter:card" content="summary">
    <meta name="twitter:title" content="{{ pageTitle }}">
    <meta name="twitter:description" content="{{ pageDescription }}">
    
    {% if isPost %}
      {% if page.date %}
      <meta property="article:published_time" content="{{ page.date | dateIso }}">
      {% endif %}
      {% if tags %}
        {% for tag in tags %}
        <meta property="article:tag" content="{{ tag }}">
        {% endfor %}
      {% endif %}
    {% endif %}
    
    <link rel="stylesheet" href="/assets/css/site.css">
  </head>
  <body>
    <div class="page">
      <header class="site-header">
        <div class="site-branding">
          <eleventy-image src="{{ '/images/me2022-small-square.jpg' | base64 }}" alt="{{ site.author.name | base64 }}"></eleventy-image>
          <a class="site-title" href="/">{{ site.title }}</a>
        </div>
        {% if site.menu %}
        <nav aria-label="Primary">
          <ul class="site-nav">
            {% for item in site.menu %}
            <li><a href="{{ item.url }}">{{ item.name }}</a></li>
            {% endfor %}
          </ul>
        </nav>
        {% endif %}
      </header>
      <main>
        {% block content %}{% endblock %}
      </main>
      <footer class="site-footer">
        <p>&copy; {{ site.author.name }}</p>
        <ul class="site-social">
          {% for item in site.social %}
          <li><a href="{{ item.url }}">{{ item.name }}</a></li>
          {% endfor %}
        </ul>
      </footer>
    </div>
    <script data-goatcounter="https://andreabergia.goatcounter.com/count"
            async
            src="//gc.zgo.at/count.v5.js"
            crossorigin="anonymous"
            integrity="sha384-atnOLvQb9t+jTSipvd75X2yginT4PjVbqDdlJAmxMm+wYElFmeR6EmLP5bYeoRVQ"></script>
  </body>
</html>
