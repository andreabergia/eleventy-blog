{% macro breadcrumb(segments=[]) %}
<nav class="crumb" aria-label="Breadcrumb">
  <a class="crumb-link" href="/post/">
    <svg class="crumb-icon" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M2.5 1A1.5 1.5 0 0 0 1 2.5v11A1.5 1.5 0 0 0 2.5 15h11a1.5 1.5 0 0 0 1.5-1.5v-11A1.5 1.5 0 0 0 13.5 1h-11ZM3 2.5a.5.5 0 0 1 .5-.5H6v3H3V2.5ZM7 2h3.5a.5.5 0 0 1 .5.5V5H7V2Zm-4 5V6h3v1H3Zm4 0V6h4.5a.5.5 0 0 1 .5.5V7H7Zm0 1h5v5.5a.5.5 0 0 1-.5.5H7V8Zm-1 6V8H3v6h3Z"/></svg>
    <span>Blog</span>
  </a>
  {% for segment in segments %}
    <span class="crumb-separator">›</span>
    {% if segment.url %}
      <a class="crumb-link" href="{{ segment.url }}">{{ segment.label }}</a>
    {% else %}
      <span class="crumb-current">{{ segment.label }}</span>
    {% endif %}
  {% endfor %}
</nav>
{% endmacro %}
